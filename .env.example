# ─────────────────────────────────────────────────────────────
# Jarvis environment
# Copy to .env.local (web) / .env (worker) and fill in.
# Nothing here is hardcoded per-business — businesses are rows in
# the database, managed from Settings.
# ─────────────────────────────────────────────────────────────

# Supabase (one project for Jarvis)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=
# Default model used for goals, agents, and voice answers
ANTHROPIC_MODEL=claude-opus-4-8

# Simple gate for this personal app (web middleware checks this).
# Set a long random string; you'll enter it once in the browser.
APP_PASSWORD=
# Secret used to sign the session cookie + protect worker cron endpoints.
APP_SECRET=

# Encryption key for stored connection credentials (NMI key, Meta token…).
# Generate with:  openssl rand -base64 32
CREDENTIALS_ENC_KEY=

# Web app URL (used by the worker to call back into the app)
APP_URL=http://localhost:3000

# Worker (Railway) — how often agents are checked, and shared auth
WORKER_PORT=8080
CRON_SECRET=

# ── Connectors ──────────────────────────────────────────────
# These are entered in the app's "Connections" screen and stored
# (encrypted) in Supabase. The values below are only fallbacks for
# local dev / single-tenant use.

# NMI (revenue) — Payment gateway Query API security key
NMI_SECURITY_KEY=

# Meta (ad spend) — Marketing API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Timezone for "today" / "yesterday" rollups
APP_TIMEZONE=America/New_York
