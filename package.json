{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Jarvis — a single snapshot of your businesses plus build-and-deploy AI agents. Stack: Vercel (web), Railway (worker), Supabase, Claude.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "worker:dev": "npm run dev --workspace=apps/worker",
    "worker:start": "npm run start --workspace=apps/worker"
  },
  "engines": {
    "node": ">=20"
  }
}
